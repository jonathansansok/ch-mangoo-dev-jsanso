# Test DB (schema separado del de dev). Crear con:
#   mysql -uroot -prootpass -h127.0.0.1 -e "CREATE DATABASE IF NOT EXISTS oferta_test"
#   DATABASE_URL=$DATABASE_URL_TEST pnpm prisma migrate deploy
DATABASE_URL_TEST="mysql://root:rootpass@localhost:3306/oferta_test"

# Mock — los tests e2e interceptan OpenAI con MSW, esta key no se usa contra la API real
OPENAI_API_KEY="sk-test-mock-no-real-calls"
