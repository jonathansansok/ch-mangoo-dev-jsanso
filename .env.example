# Database
DATABASE_URL="mysql://root:rootpass@localhost:3306/oferta"

# OpenAI
OPENAI_API_KEY=""

# Budget guard (max tokens por corrida de pipeline)
MAX_TOKENS_PER_RUN="100000"

# Reconcile knobs
MIN_SIMILARITY="0.55"
TRUST_JUDGE_CONFIDENCE="0.7"
JUDGE_BATCH_SIZE="10"
SHORTLIST_K="10"
QTY_RATIO_MIN="0.1"
QTY_RATIO_MAX="3.0"

# Reverse pass (recupera matches que forward judge clasificó como extra+faltante)
REVERSE_PASS_K="8"
REVERSE_PASS_MIN_SIMILARITY="0.55"
REVERSE_PASS_MIN_CONFIDENCE="0.7"

# Models
# EXTRACT_MODEL: cheap, suficiente con chunking
EXTRACT_MODEL="gpt-4o-mini"
# JUDGE_MODEL: usado para forward judge y reverse pass. gpt-4.1-mini razona mejor
# semántica (Lavandina↔Hipoclorito) sin disparar costo de gpt-4o.
JUDGE_MODEL="gpt-4.1-mini"
EMBED_MODEL="text-embedding-3-small"

# Node env
NODE_ENV="development"
