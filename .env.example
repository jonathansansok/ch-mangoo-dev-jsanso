JUDGE_BATCH_SIZE="10"
SHORTLIST_K="5"
QTY_RATIO_MIN="0.1"
QTY_RATIO_MAX="3.0"

# Models
JUDGE_MODEL="gpt-4o-mini"
EXTRACT_MODEL="gpt-4o-mini"
EMBED_MODEL="text-embedding-3-small"

# Node env
NODE_ENV="development"
