# Database
DATABASE_URL="mysql://root:rootpass@localhost:3306/oferta"

# OpenAI
OPENAI_API_KEY=""

# Budget guard (max tokens por corrida de pipeline)
MAX_TOKENS_PER_RUN="100000"

# Reconcile knobs
